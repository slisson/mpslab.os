.gradle/
**/build/
.kotlin/
.idea/
*.iml
.DS_Store

# MPS generator output. The modules here are authored as `.mps` models; everything the
# generator derives from them is rebuilt by `./gradlew generate`.
**/classes_gen/
**/source_gen/
**/source_gen.caches/
**/test_gen/
**/test_gen.caches/
**/.mps-caches/

# The npm project that compiles and runs the generated TypeScript. package.json,
# package-lock.json and tsconfig.json are checked in; what npm and tsc produce is not
# (tsc writes into build/, which is already ignored above).
node_modules/
